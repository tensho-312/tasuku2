<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>学校図書室 貸出・返却管理システム</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter & Noto Sans JP -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans JP', 'Inter', sans-serif;
        }
        [v-cloak] { display: none; }
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- ヘッダー -->
    <header class="bg-indigo-700 text-white shadow-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-indigo-600 rounded-lg">
                    <i class="fa-solid fa-book-bookmark text-xl text-amber-300"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight">学校図書室 管理システム</h1>
                    <p class="text-xs text-indigo-200 hidden sm:block">貸出・返却 リアルタイム管理アプリ</p>
                </div>
            </div>

            <!-- ユーザー情報 & ログアウトボタン（ログイン時表示） -->
            <div id="user-profile" class="hidden flex items-center space-x-3">
                <div class="flex items-center space-x-2 bg-indigo-800/60 px-3 py-1.5 rounded-full border border-indigo-500/30">
                    <img id="user-avatar" src="" alt="Avatar" class="w-7 h-7 rounded-full border border-white">
                    <span id="user-name" class="text-xs sm:text-sm font-medium max-w-[120px] sm:max-w-[180px] truncate"></span>
                </div>
                <button id="btn-logout" class="bg-indigo-800 hover:bg-rose-600 text-white text-xs sm:text-sm px-3 py-1.5 rounded-lg font-medium transition flex items-center space-x-1 shadow-sm">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span class="hidden sm:inline">ログアウト</span>
                </button>
            </div>
        </div>
    </header>

    <!-- ログイン未認証画面 (保護用モーダル/画面) -->
    <section id="auth-screen" class="flex-grow flex items-center justify-center p-4">
        <div class="max-w-md w-full bg-white rounded-2xl shadow-xl border border-slate-200/80 p-8 text-center transition-all">
            <div class="w-20 h-20 bg-indigo-100 rounded-full flex items-center justify-center mx-auto mb-6 text-indigo-600 shadow-inner">
                <i class="fa-solid fa-user-lock text-3xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-800 mb-2">ログインが必要です</h2>
            <p class="text-slate-600 text-sm mb-6 leading-relaxed">
                本アプリは学校図書室関係者専用です。<br>Googleアカウントでログインしてご利用ください。
            </p>
            
            <button id="btn-google-login" class="w-full bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold py-3 px-4 rounded-xl shadow-sm transition flex items-center justify-center space-x-3 group hover:border-slate-400">
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                </svg>
                <span>Google アカウントでログイン</span>
            </button>

            <p class="text-xs text-slate-400 mt-6">
                ※認証データはFirebase Authenticationによって安全に管理されます。
            </p>
        </div>
    </section>

    <!-- メインコンテンツ (ログイン済みの時のみ表示) -->
    <main id="app-screen" class="hidden flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

        <!-- 統計サマリーカード -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-4">
                <div class="p-3 bg-blue-100 text-blue-600 rounded-lg text-xl">
                    <i class="fa-solid fa-book"></i>
                </div>
                <div>
                    <p class="text-xs text-slate-500 font-medium">総登録件数</p>
                    <p id="stat-total" class="text-2xl font-bold text-slate-800">0</p>
                </div>
            </div>
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-4">
                <div class="p-3 bg-amber-100 text-amber-600 rounded-lg text-xl">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div>
                    <p class="text-xs text-slate-500 font-medium">現在貸出中</p>
                    <p id="stat-checkout" class="text-2xl font-bold text-amber-600">0</p>
                </div>
            </div>
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-4">
                <div class="p-3 bg-emerald-100 text-emerald-600 rounded-lg text-xl">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div>
                    <p class="text-xs text-slate-500 font-medium">返却完了</p>
                    <p id="stat-returned" class="text-2xl font-bold text-emerald-600">0</p>
                </div>
            </div>
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-4">
                <div class="p-3 bg-rose-100 text-rose-600 rounded-lg text-xl">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div>
                    <p class="text-xs text-slate-500 font-medium">返却期限超過</p>
                    <p id="stat-overdue" class="text-2xl font-bold text-rose-600">0</p>
                </div>
            </div>
        </div>

        <!-- 登録フォーム＆ガイドグリッド -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- 貸出・返却 記録入力フォーム（5項目） -->
            <div class="lg:col-span-1 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <div class="flex items-center space-x-2 border-b border-slate-100 pb-4 mb-6">
                    <i class="fa-solid fa-pen-to-square text-indigo-600 text-lg"></i>
                    <h2 class="text-lg font-bold text-slate-800">新規貸出の記録 (5項目)</h2>
                </div>

                <form id="record-form" class="space-y-4">
                    <!-- 項目1: 学年・組 -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">1. 学年・組 <span class="text-rose-500">*</span></label>
                        <select id="input-grade-class" required class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition">
                            <option value="">選択してください</option>
                            <option value="1年1組">1年1組</option>
                            <option value="1年2組">1年2組</option>
                            <option value="2年1組">2年1組</option>
                            <option value="2年2組">2年2組</option>
                            <option value="3年1組">3年1組</option>
                            <option value="3年2組">3年2組</option>
                            <option value="教職員">教職員</option>
                        </select>
                    </div>

                    <!-- 項目2: 氏名 -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">2. 借用者氏名 <span class="text-rose-500">*</span></label>
                        <input type="text" id="input-borrower-name" placeholder="例: 山田 太郎" required class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition">
                    </div>

                    <!-- 項目3: 図書名 -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">3. 本のタイトル・蔵書ID <span class="text-rose-500">*</span></label>
                        <input type="text" id="input-book-title" placeholder="例: 走れメロス (ID: B-102)" required class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition">
                    </div>

                    <!-- 項目4: 貸出日 -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">4. 貸出日 <span class="text-rose-500">*</span></label>
                        <input type="date" id="input-checkout-date" required class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition">
                    </div>

                    <!-- 項目5: 返却予定日 -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">5. 返却予定日 <span class="text-rose-500">*</span></label>
                        <input type="date" id="input-due-date" required class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition">
                    </div>

                    <button type="submit" id="btn-submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-4 rounded-xl shadow transition duration-150 flex items-center justify-center space-x-2 mt-6">
                        <i class="fa-solid fa-plus"></i>
                        <span>データを登録する</span>
                    </button>
                </form>
            </div>

            <!-- 一覧表示・検索テーブルエリア -->
            <div class="lg:col-span-2 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                <div>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-4">
                        <div class="flex items-center space-x-2">
                            <i class="fa-solid fa-list-check text-indigo-600 text-lg"></i>
                            <h2 class="text-lg font-bold text-slate-800">貸出記録一覧 (Firestore同期)</h2>
                        </div>
                        
                        <!-- 検索 & フィルター -->
                        <div class="flex items-center space-x-2">
                            <div class="relative w-full sm:w-48">
                                <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                                <input type="text" id="search-query" placeholder="氏名・本で検索..." class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-8 pr-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            </div>
                            <select id="filter-status" class="bg-slate-50 border border-slate-200 rounded-lg px-2 py-1.5 text-xs text-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                <option value="all">すべての状態</option>
                                <option value="貸出中">貸出中のみ</option>
                                <option value="返却完了">返却完了のみ</option>
                            </select>
                        </div>
                    </div>

                    <!-- テーブル表示 -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs sm:text-sm">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 border-b border-slate-200">
                                    <th class="py-3 px-3 font-semibold">借用者</th>
                                    <th class="py-3 px-3 font-semibold">図書名</th>
                                    <th class="py-3 px-3 font-semibold">貸出日 / 予定日</th>
                                    <th class="py-3 px-3 font-semibold">ステータス</th>
                                    <th class="py-3 px-3 font-semibold text-right">操作</th>
                                </tr>
                            </thead>
                            <tbody id="records-list" class="divide-y divide-slate-100">
                                <tr>
                                    <td colspan="5" class="py-8 text-center text-slate-400">
                                        <i class="fa-solid fa-spinner animate-spin text-indigo-500 text-xl mb-2"></i>
                                        <p>データを読み込み中...</p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- フッター説明 -->
                <p class="text-xs text-slate-400 mt-4 border-t border-slate-100 pt-3">
                    ※Firestoreデータベースに同期されるため、ページを再読み込みしてもデータは消えません。
                </p>
            </div>
        </div>

        <!-- デプロイ・公開案内ガイドカード -->
        <section class="bg-slate-800 text-slate-100 p-6 sm:p-8 rounded-2xl shadow-md border border-slate-700">
            <div class="flex items-center space-x-3 mb-4 border-b border-slate-700 pb-3">
                <i class="fa-brands fa-github text-2xl text-indigo-400"></i>
                <i class="fa-solid fa-fire text-2xl text-amber-500"></i>
                <h3 class="text-lg font-bold">GitHub (`libraryapp`) & Firebase Hosting 公開の手順</h3>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm">
                <div>
                    <h4 class="font-bold text-amber-400 mb-2 flex items-center space-x-2">
                        <span class="bg-amber-400/20 text-amber-300 w-5 h-5 rounded-full inline-flex items-center justify-center text-xs">1</span>
                        <span>GitHub リポジトリ作成 & アップロード</span>
                    </h4>
                    <ol class="list-decimal list-inside space-y-1.5 text-slate-300 bg-slate-900/60 p-4 rounded-xl font-mono text-xs">
                        <li>GitHubで <code class="text-amber-300">libraryapp</code> というリポジトリを作成</li>
                        <li>ターミナルで本ファイルの保存場所に移動して実行:</li>
                        <li class="pl-2 text-indigo-300">git init</li>
                        <li class="pl-2 text-indigo-300">git add index.html</li>
                        <li class="pl-2 text-indigo-300">git commit -m "Initial commit"</li>
                        <li class="pl-2 text-indigo-300">git branch -M main</li>
                        <li class="pl-2 text-indigo-300">git remote add origin https://github.com/ユーザー名/libraryapp.git</li>
                        <li class="pl-2 text-indigo-300">git push -u origin main</li>
                    </ol>
                </div>

                <div>
                    <h4 class="font-bold text-amber-400 mb-2 flex items-center space-x-2">
                        <span class="bg-amber-400/20 text-amber-300 w-5 h-5 rounded-full inline-flex items-center justify-center text-xs">2</span>
                        <span>Firebase Hosting でインターネット公開</span>
                    </h4>
                    <ol class="list-decimal list-inside space-y-1.5 text-slate-300 bg-slate-900/60 p-4 rounded-xl font-mono text-xs">
                        <li>Firebase CLI をインストール: <code class="text-indigo-300">npm install -g firebase-tools</code></li>
                        <li>Firebaseにログイン: <code class="text-indigo-300">firebase login</code></li>
                        <li>プロジェクト初期化: <code class="text-indigo-300">firebase init hosting</code></li>
                        <li class="pl-4 text-slate-400">・プロジェクト: tasuku2-199b1 を選択</li>
                        <li class="pl-4 text-slate-400">・Public directory: <code class="text-amber-300">.</code> (カレントディレクトリ)</li>
                        <li class="pl-4 text-slate-400">・Single-page app: <code class="text-amber-300">y</code></li>
                        <li>Web上に公開: <code class="text-indigo-300">firebase deploy</code></li>
            const firebaseConfig = {
  apiKey: "AIzaSyCkuzJbnf4DF9ImRmCCnjwV9vvPLFHgGbQ",
  authDomain: "tasuku2-199b1.firebaseapp.com",
  projectId: "tasuku2-199b1",
  storageBucket: "tasuku2-199b1.firebasestorage.app",
  messagingSenderId: "1002753320646",
  appId: "1:1002753320646:web:17a567f489f60b9bbc59c7"
};
                </div>
            </div>
        </section>
    </main>

    <!-- フッター -->
    <footer class="bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-500">
        <p>&copy; 2026 学校図書室 貸出・返却管理システム | Powered by Firebase & GitHub</p>
    </footer>

    <!-- JS Firebase Logics -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { 
            getAuth, 
            GoogleAuthProvider, 
            signInWithPopup, 
            signOut, 
            onAuthStateChanged 
        } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { 
            getFirestore, 
            collection, 
            addDoc, 
            updateDoc, 
            deleteDoc, 
            doc, 
            onSnapshot, 
            serverTimestamp 
        } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // 指定された Firebase 設定
        const firebaseConfig = {
            apiKey: "AIzaSyCkuzJbnf4DF9ImRmCCnjwV9vvPLFHgGbQ",
            authDomain: "tasuku2-199b1.firebaseapp.com",
            projectId: "tasuku2-199b1",
            storageBucket: "tasuku2-199b1.firebasestorage.app",
            messagingSenderId: "1002753320646",
            appId: "1:1002753320646:web:17a567f489f60b9bbc59c7"
        };

        // Firebaseの初期化
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const provider = new GoogleAuthProvider();

        // UI要素参照
        const authScreen = document.getElementById("auth-screen");
        const appScreen = document.getElementById("app-screen");
        const userProfile = document.getElementById("user-profile");
        const userAvatar = document.getElementById("user-avatar");
        const userName = document.getElementById("user-name");

        const btnGoogleLogin = document.getElementById("btn-google-login");
        const btnLogout = document.getElementById("btn-logout");

        const recordForm = document.getElementById("record-form");
        const inputGradeClass = document.getElementById("input-grade-class");
        const inputBorrowerName = document.getElementById("input-borrower-name");
        const inputBookTitle = document.getElementById("input-book-title");
        const inputCheckoutDate = document.getElementById("input-checkout-date");
        const inputDueDate = document.getElementById("input-due-date");

        const recordsList = document.getElementById("records-list");
        const searchQuery = document.getElementById("search-query");
        const filterStatus = document.getElementById("filter-status");

        const statTotal = document.getElementById("stat-total");
        const statCheckout = document.getElementById("stat-checkout");
        const statReturned = document.getElementById("stat-returned");
        const statOverdue = document.getElementById("stat-overdue");

        // 日付の初期設定（貸出日：本日、返却予定日：14日後）
        const today = new Date();
        const defaultDue = new Date();
        defaultDue.setDate(today.getDate() + 14);

        inputCheckoutDate.value = today.toISOString().split('T')[0];
        inputDueDate.value = defaultDue.toISOString().split('T')[0];

        let allRecords = [];

        // Googleログイン実行
        btnGoogleLogin.addEventListener("click", async () => {
            try {
                await signInWithPopup(auth, provider);
            } catch (error) {
                console.error("Login failed:", error);
                alert("ログインに失敗しました: " + error.message);
            }
        });

        // ログアウト実行
        btnLogout.addEventListener("click", async () => {
            try {
                await signOut(auth);
            } catch (error) {
                console.error("Logout failed:", error);
            }
        });

        // 認証状態監視 (ログインしていないと使えない制限)
        onAuthStateChanged(auth, (user) => {
            if (user) {
                // ログイン成功時
                authScreen.classList.add("hidden");
                appScreen.classList.remove("hidden");
                userProfile.classList.remove("hidden");

                userAvatar.src = user.photoURL || 'https://placehold.co/100x100/4f46e5/ffffff?text=User';
                userName.textContent = user.displayName || user.email || 'ユーザー';

                // データリアルタイム購読開始
                listenToFirestore();
            } else {
                // 未ログイン時
                authScreen.classList.remove("hidden");
                appScreen.classList.add("hidden");
                userProfile.classList.add("hidden");
            }
        });

        // データ登録 (5項目入力して保存)
        recordForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            const gradeClass = inputGradeClass.value;
            const borrowerName = inputBorrowerName.value.trim();
            const bookTitle = inputBookTitle.value.trim();
            const checkoutDate = inputCheckoutDate.value;
            const dueDate = inputDueDate.value;

            if (!gradeClass || !borrowerName || !bookTitle || !checkoutDate || !dueDate) {
                alert("すべての必須項目を入力してください。");
                return;
            }

            try {
                // Firestore コレクション参照
                const recordsRef = collection(db, "library_records");
                
                await addDoc(recordsRef, {
                    gradeClass,
                    borrowerName,
                    bookTitle,
                    checkoutDate,
                    dueDate,
                    status: "貸出中", // 初期ステータス
                    registeredBy: auth.currentUser.uid,
                    createdAt: serverTimestamp()
                });

                // フォーム初期化
                inputBorrowerName.value = "";
                inputBookTitle.value = "";
                inputCheckoutDate.value = new Date().toISOString().split('T')[0];
                const newDue = new Date();
                newDue.setDate(newDue.getDate() + 14);
                inputDueDate.value = newDue.toISOString().split('T')[0];

            } catch (error) {
                console.error("Error adding document: ", error);
                alert("登録中にエラーが発生しました: " + error.message);
            }
        });

        // Firestore リアルタイム取得
        function listenToFirestore() {
            const recordsRef = collection(db, "library_records");
            
            // クエリ（メモリ側でソート処理）
            onSnapshot(recordsRef, (snapshot) => {
                allRecords = [];
                snapshot.forEach((docSnap) => {
                    allRecords.push({
                        id: docSnap.id,
                        ...docSnap.data()
                    });
                });

                // 日付新しい順にソート
                allRecords.sort((a, b) => {
                    const dateA = a.createdAt?.toDate ? a.createdAt.toDate() : new Date(a.checkoutDate);
                    const dateB = b.createdAt?.toDate ? b.createdAt.toDate() : new Date(b.checkoutDate);
                    return dateB - dateA;
                });

                renderRecords();
            }, (error) => {
                console.error("Firestore Listen Error:", error);
            });
        }

        // 一覧レンダリング & フィルター
        function renderRecords() {
            const query = searchQuery.value.toLowerCase().trim();
            const statusFilter = filterStatus.value;

            const filtered = allRecords.filter((rec) => {
                const matchesText = rec.borrowerName.toLowerCase().includes(query) ||
                                    rec.bookTitle.toLowerCase().includes(query) ||
                                    rec.gradeClass.toLowerCase().includes(query);
                
                const matchesStatus = statusFilter === "all" || rec.status === statusFilter;

                return matchesText && matchesStatus;
            });

            // 集計計算
            const todayStr = new Date().toISOString().split('T')[0];
            let checkoutCount = 0;
            let returnedCount = 0;
            let overdueCount = 0;

            allRecords.forEach(r => {
                if (r.status === "貸出中") {
                    checkoutCount++;
                    if (r.dueDate < todayStr) overdueCount++;
                } else if (r.status === "返却完了") {
                    returnedCount++;
                }
            });

            statTotal.textContent = allRecords.length;
            statCheckout.textContent = checkoutCount;
            statReturned.textContent = returnedCount;
            statOverdue.textContent = overdueCount;

            // テーブル描画
            if (filtered.length === 0) {
                recordsList.innerHTML = `
                    <tr>
                        <td colspan="5" class="py-8 text-center text-slate-400">
                            該当する貸出記録が見つかりません。
                        </td>
                    </tr>
                `;
                return;
            }

            recordsList.innerHTML = filtered.map((rec) => {
                const isOverdue = rec.status === "貸出中" && rec.dueDate < todayStr;
                
                let badgeClass = "bg-amber-100 text-amber-800 border-amber-200";
                let badgeText = "貸出中";

                if (rec.status === "返却完了") {
                    badgeClass = "bg-emerald-100 text-emerald-800 border-emerald-200";
                    badgeText = "返却完了";
                } else if (isOverdue) {
                    badgeClass = "bg-rose-100 text-rose-800 border-rose-200 animate-pulse";
                    badgeText = "期限超過";
                }

                return `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="py-3 px-3">
                            <span class="inline-block bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded text-xs font-medium mr-1">${escapeHtml(rec.gradeClass)}</span>
                            <span class="font-bold text-slate-800">${escapeHtml(rec.borrowerName)}</span>
                        </td>
                        <td class="py-3 px-3 font-medium text-slate-700">
                            ${escapeHtml(rec.bookTitle)}
                        </td>
                        <td class="py-3 px-3 text-xs text-slate-500">
                            <div>貸: ${rec.checkoutDate}</div>
                            <div class="${isOverdue ? 'text-rose-600 font-bold' : ''}">返: ${rec.dueDate}</div>
                        </td>
                        <td class="py-3 px-3">
                            <span class="px-2 py-1 rounded-full text-xs border font-medium inline-block ${badgeClass}">
                                ${badgeText}
                            </span>
                        </td>
                        <td class="py-3 px-3 text-right space-x-1">
                            ${rec.status === "貸出中" ? `
                                <button onclick="window.toggleReturn('${rec.id}', '返却完了')" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-2.5 py-1 rounded-lg transition shadow-sm">
                                    <i class="fa-solid fa-check mr-1"></i>返却
                                </button>
                            ` : `
                                <button onclick="window.toggleReturn('${rec.id}', '貸出中')" class="bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs px-2 py-1 rounded-lg transition">
                                    再貸出
                                </button>
                            `}
                            <button onclick="window.deleteRecord('${rec.id}')" class="text-slate-400 hover:text-rose-600 p-1 rounded transition" title="削除">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // HTMLエスケープヘルパー
        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>"']/g, function(m) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                }[m];
            });
        }

        // 検索＆フィルターイベント
        searchQuery.addEventListener("input", renderRecords);
        filterStatus.addEventListener("change", renderRecords);

        // ステータス切り替え（返却処理）
        window.toggleReturn = async (id, newStatus) => {
            try {
                const docRef = doc(db, "library_records", id);
                await updateDoc(docRef, { status: newStatus });
            } catch (error) {
                console.error("Status update error:", error);
            }
        };

        // レコード削除
        window.deleteRecord = async (id) => {
            if (!confirm("この記録を削除してもよろしいですか？")) return;
            try {
                const docRef = doc(db, "library_records", id);
                await deleteDoc(docRef);
            } catch (error) {
                console.error("Delete error:", error);
            }
        };
    </script>
</body>
</html>
